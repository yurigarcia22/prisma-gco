# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel (produção).
# Os valores do Supabase ficam no painel: Project Settings > API Keys.

# Endereço do projeto Supabase (público)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública (sb_publishable_...). Pode ir pro navegador.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave secreta (sb_secret_...). SÓ no servidor. Passa por cima de toda a RLS.
SUPABASE_SECRET_KEY=

# Endereço público do site, sem barra no fim. Monta os links de cliente (/p/...) e corretor (/c/...).
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# Senha da rotina diária (/api/cron/diario). Qualquer texto longo e aleatório.
# Na Vercel, o cron manda "Authorization: Bearer <CRON_SECRET>" sozinho.
CRON_SECRET=
